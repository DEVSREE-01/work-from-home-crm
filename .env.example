# Server Configuration
PORT=3000

# Database Configuration
DATABASE_PATH=./leads.db

# CORS Settings (for production, specify your domain)
ALLOWED_ORIGINS=*

# Optional: Add authentication credentials
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your_secure_password

# Optional: Email notifications (if implementing)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Optional: WhatsApp Business API (if implementing)
# WHATSAPP_API_KEY=your_api_key
# WHATSAPP_PHONE_NUMBER=your_number
